<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="14-facturas-add-cliente-id" author="german">
        <!-- Agregar columna cliente_id con FK hacia clientes -->
        <addColumn tableName="facturas">
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="clientes" referencedColumnNames="id" foreignKeyName="fk_facturas_clientes"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="16-usuarios" author="german">
        <createTable tableName="usuarios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="nombre" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="contrasena" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="rol_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="roles" referencedColumnNames="id" foreignKeyName="fk_usuarios_roles"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
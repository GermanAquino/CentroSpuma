<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="23-recreate-perfiles" author="kisser">
        <!-- Borrar tabla anterior -->
        <dropTable tableName="perfiles"/>

        <!-- Crear tabla nueva -->
        <createTable tableName="perfiles">
            <!-- Nota: usuario_id será PK y FK al mismo tiempo -->
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="telefono" type="TEXT"/>
            <column name="direccion" type="TEXT"/>
            <column name="avatar_url" type="TEXT"/>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <!-- Crear FK hacia usuarios -->
        <addForeignKeyConstraint
                baseTableName="perfiles"
                baseColumnNames="usuario_id"
                constraintName="fk_perfiles_usuarios"
                referencedTableName="usuarios"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
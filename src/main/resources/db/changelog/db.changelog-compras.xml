<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="1" author="german">
        <createTable tableName="compras">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="proveedor_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="proveedores" referencedColumnNames="id" foreignKeyName="fk_compras_proveedores"/>
            </column>

            <column name="fecha" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>

            <column name="total" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
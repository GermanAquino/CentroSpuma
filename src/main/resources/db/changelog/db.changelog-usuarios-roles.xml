<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Cambiar relación usuarios-roles a muchos a muchos -->
    <changeSet id="24-usuarios-roles-m2m" author="german">

        <!-- 1. Eliminar la FK existente -->
        <dropForeignKeyConstraint
                baseTableName="usuarios"
                constraintName="fk_usuarios_roles"/>

        <!-- 2. Eliminar la columna rol_id -->
        <dropColumn tableName="usuarios" columnName="rol_id"/>

        <!-- 3. Crear tabla intermedia usuarios_roles -->
        <createTable tableName="usuarios_roles">
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rol_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 4. Definir claves foráneas -->
        <addForeignKeyConstraint
                baseTableName="usuarios_roles"
                baseColumnNames="usuario_id"
                referencedTableName="usuarios"
                referencedColumnNames="id"
                constraintName="fk_usuarios_roles_usuario"/>

        <addForeignKeyConstraint
                baseTableName="usuarios_roles"
                baseColumnNames="rol_id"
                referencedTableName="roles"
                referencedColumnNames="id"
                constraintName="fk_usuarios_roles_rol"/>

        <!-- 5. Definir PK compuesta para evitar duplicados -->
        <addPrimaryKey
                tableName="usuarios_roles"
                columnNames="usuario_id, rol_id"
                constraintName="usuarios_roles_pkey"/>
    </changeSet>

</databaseChangeLog>
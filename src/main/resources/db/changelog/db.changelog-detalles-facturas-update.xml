<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="10-detalles-facturas-update" author="german">
        
        <!-- 1. Eliminar la FK existente hacia facturas -->
        <dropForeignKeyConstraint 
            baseTableName="detalles_facturas" 
            constraintName="fk_detalles_facturas_facturas"/>
        
        <!-- 2. Agregar la columna venta_id con FK hacia ventas -->
        <addColumn tableName="detalles_facturas">
            <column name="venta_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="ventas" referencedColumnNames="id" foreignKeyName="fk_detalles_facturas_ventas"/>
            </column>
        </addColumn>
        
        <!-- 3. Eliminar la columna factura_id -->
        <dropColumn tableName="detalles_facturas" columnName="factura_id"/>

    </changeSet>

</databaseChangeLog>
